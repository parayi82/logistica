# Proyecto Supabase (Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Solo para Edge Functions / jobs server-side (NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Fase 3 — WhatsApp Business Platform (Meta Cloud API)
# Estas 4 se configuran como secrets de la Edge Function (supabase secrets
# set), NO en este .env del frontend: https://developers.facebook.com/apps
WHATSAPP_VERIFY_TOKEN=un-valor-que-tu-inventas-para-la-verificacion-del-webhook
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App secret de la app de Meta (Configuración básica); firma cada webhook
# entrante (X-Hub-Signature-256). Si se omite, la función funciona pero sin
# verificar la firma (solo aceptable en desarrollo).
WHATSAPP_APP_SECRET=
