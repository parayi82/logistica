# Proyecto Supabase (Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Solo para Edge Functions / jobs server-side (NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Fase 3 — Telegram Bot API
# Estas 2 se configuran como secrets de la Edge Function (supabase secrets
# set), NO en este .env del frontend. El token lo da @BotFather al crear
# el bot (sin verificación de negocio, sin cuenta de developer).
TELEGRAM_BOT_TOKEN=
# Cadena que tú inventas; Telegram la reenvía en cada webhook (header
# X-Telegram-Bot-Api-Secret-Token) para que puedas verificar que es
# realmente Telegram quien llama. Si se omite, la función funciona pero
# sin verificar (solo aceptable en desarrollo).
TELEGRAM_WEBHOOK_SECRET=
